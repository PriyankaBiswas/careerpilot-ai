# Copy into Streamlit Community Cloud: App settings > Secrets (or a local .streamlit/secrets.toml,
# which is git-ignored). Never commit real values.

# Supabase Session pooler URI (IPv4). URL-encode special characters in the password.
DATABASE_URL = "postgresql://postgres.YOUR-PROJECT-REF:YOUR-URL-ENCODED-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# 'manual' (default, no API key, no cost) or 'openai' (opt-in, billed by OpenAI).
AI_PROVIDER = "manual"

# Optional second layer behind Streamlit's private-app viewer controls. 16+ characters, or leave out.
# APP_PASSWORD = "replace-with-long-unique-password"

# Only needed when AI_PROVIDER = "openai".
# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-4.1-mini"
