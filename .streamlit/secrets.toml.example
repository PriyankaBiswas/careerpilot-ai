# Copy into Streamlit Community Cloud: App settings > Secrets (or a local .streamlit/secrets.toml,
# which is git-ignored). Never commit real values. All keys must be at the TOML root (no [sections]).

# Supabase Session pooler URI (IPv4). URL-encode special characters in the password.
DATABASE_URL = "postgresql://postgres.YOUR-PROJECT-REF:YOUR-URL-ENCODED-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# 'openai' (default: generate inside the app, billed by OpenAI) or 'manual' (copy/paste, no API key).
AI_PROVIDER = "openai"
OPENAI_API_KEY = "sk-..."

# Optional (defaults shown).
# OPENAI_MODEL = "gpt-6.1-terra"              # resume drafting, section regeneration, STAR answers
# OPENAI_FAST_MODEL = "gpt-6-luna"            # job matching and AI evidence check; "none" = use OPENAI_MODEL
# OPENAI_MAX_OUTPUT_TOKENS = "16000"          # per call, includes reasoning tokens
# OPENAI_MAX_COST_PER_OPERATION = "0.25"      # USD; worst-case estimates above this are blocked
# OPENAI_REASONING_EFFORT = "medium"          # none | low | medium | high | xhigh | max
# OPENAI_FAST_REASONING_EFFORT = "low"
# OPENAI_PRICES = '{"gpt-6.1-terra": {"input": 1.0, "cached_input": 0.05, "output": 5.0}}'

# Optional second layer behind Streamlit's private-app viewer controls. 16+ characters, or leave out.
# APP_PASSWORD = "replace-with-long-unique-password"
