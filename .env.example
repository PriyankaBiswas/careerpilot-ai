# Local Docker only. Copy to .env (git-ignored). Streamlit Community Cloud uses Secrets instead.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_FAST_MODEL=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=16000
OPENAI_MAX_COST_PER_OPERATION=0.25
# Optional locally; strongly recommended for any Docker host that is publicly reachable.
APP_PASSWORD=replace-with-long-unique-password
# Docker Compose overrides this with its local Postgres service.
DATABASE_URL=postgresql://user:password@host:5432/database
